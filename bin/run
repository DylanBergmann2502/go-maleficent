#!/bin/bash
# bin/run

# Make script executable from anywhere
cd "$(dirname "$0")/.."

# Use ENV from environment or default to local
ENV=${ENV:-local}
COMPOSE_FILE="deploy/${ENV}/web.yml"

# Check if Docker is installed and running
check_docker() {
    if ! docker info > /dev/null 2>&1; then
        echo "Error: Docker is not running or not installed"
        exit 1
    fi
}

# Validate environment
validate_env() {
    if [ "$ENV" != "local" ] && [ "$ENV" != "production" ]; then
        echo "Error: Invalid environment. Must be 'local' or 'production'"
        exit 1
    fi

    if [ ! -f "$COMPOSE_FILE" ]; then
        echo "Error: Compose file not found: $COMPOSE_FILE"
        exit 1
    fi
}

validate_env

case "$1" in
    "check")
        # Check Docker versions
        echo "Checking Docker installations..."
        docker --version
        docker compose version
        ;;

    "build")
        check_docker
        docker compose -f $COMPOSE_FILE build
        ;;

    "up")
        check_docker
        shift  # Remove 'up' from arguments
        docker compose -f $COMPOSE_FILE up "$@"
        ;;

    "start")
        check_docker
        shift  # Remove 'start' from arguments
        docker compose -f $COMPOSE_FILE up --build --remove-orphans "$@"
        ;;

    "stop")
        check_docker
        shift  # Remove 'stop' from arguments
        docker compose -f $COMPOSE_FILE stop "$@"
        ;;

    "down")
        check_docker
        shift  # Remove 'down' from arguments
        docker compose -f $COMPOSE_FILE down "$@"
        ;;

    "logs")
        check_docker
        docker compose -f $COMPOSE_FILE logs -f
        ;;

    "ps")
        # List running containers
        check_docker
        docker compose -f $COMPOSE_FILE ps
        ;;

    "restart")
        # Restart all containers
        check_docker
        docker compose -f $COMPOSE_FILE restart
        ;;

    "format")
        # Format Go code with goimports
        check_docker
        shift  # Remove 'format' from arguments
        docker compose -f $COMPOSE_FILE run --rm go goimports -w "${@:-.}"
        ;;

    "lint")
        # Lint Go code with golangci-lint
        check_docker
        shift  # Remove 'lint' from arguments
        docker compose -f $COMPOSE_FILE run --rm go golangci-lint run "${@}"
        ;;

    "test")
        # Run the Docker test profile against the isolated test database
        check_docker
        docker compose -f "$COMPOSE_FILE" --profile test run --build --rm go_test
        ;;

    "setup")
        # Initialize local Garage layout, credentials, and bucket
        check_docker
        if [ "$ENV" != "local" ]; then
            echo "Error: Garage setup is only available for the local environment"
            exit 1
        fi
        docker compose -f deploy/local/setup.yml up --build --abort-on-container-exit --exit-code-from setup_complete
        ;;

    "deps")
        # Add or update Go module dependencies inside the Go container
        check_docker
        shift  # Remove 'deps' from arguments
        if [ "$#" -eq 0 ]; then
            echo "Error: At least one Go module is required"
            echo "Usage: ./bin/run deps <module>[@version] [module[@version] ...]"
            exit 1
        fi
        docker compose -f "$COMPOSE_FILE" run --rm go go get "$@"
        ;;

    "migrate")
        # Run database migrations using server binary
        check_docker
        shift  # Remove 'migrate' from arguments
        docker compose -f $COMPOSE_FILE run --rm go go run cmd/server/main.go migrate "$@"
        ;;

    "migrate:create")
        # Create a new migration file using golang-migrate CLI
        check_docker
        if [ -z "$2" ]; then
            echo "Error: Migration name required"
            echo "Usage: ./bin/run migrate:create <migration_name>"
            exit 1
        fi
        echo "Creating new migration: $2"
        docker compose -f $COMPOSE_FILE run --rm go migrate create -ext sql -dir internal/pkg/database/migrations -seq $2
        ;;

    *)
        echo "Go Maleficent Management Commands"
        echo "================================="
        echo "Usage:"
        echo "  ./bin/run <command>                # Uses local environment"
        echo "  ENV=production ./bin/run <command> # Uses production environment"
        echo ""
        echo "Basic Commands:"
        echo "  check               - Check Docker installations"
        echo "  build               - Build all containers"
        echo "  up [options]        - Start containers in attached mode"
        echo "  start [options]     - Build and start containers with orphan removal"
        echo "  stop [options]      - Stop containers"
        echo "  down [options]      - Stop and remove containers"
        echo "  logs                - View container logs"
        echo "  ps                  - List running containers"
        echo "  restart             - Restart all containers"
        echo ""
        echo "Code Quality Commands:"
        echo "  format [path]       - Format Go code with goimports (defaults to .)"
        echo "  lint [options]      - Lint Go code with golangci-lint"
        echo "  test                - Run the Docker test profile"
        echo "  setup               - Initialize local Garage storage"
        echo "  deps <module>...    - Add or update Go module dependencies"
        echo ""
        echo "Migration Commands:"
        echo "  migrate up [steps]      - Run migrations up (all or specific steps)"
        echo "  migrate down [steps]    - Run migrations down (default: 1 step)"
        echo "  migrate:create <name>   - Create new migration files"
        ;;
esac
